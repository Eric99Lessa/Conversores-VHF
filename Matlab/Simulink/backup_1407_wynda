function [D_bot, D_top, debug_obs, debug_deriv, debug_ctrl] = fcn(Vin_m, Vout_m, IL_m, converter_mode, Vout_ref, Ts)
%#codegen
    persistent L_nom C_nom ...
        x_pred P_pred theta_pred Gamma_pred ...
        Q R_meas R_theta ...
        inv_lambda ...
        D_bot_last D_top_last ...
        int_eVout initialized

    %% Fixed dimensions
    n_states = 5;
    n_meas = 5;
    n_theta = 3*3 + 4;
    n_params = n_states + n_theta;

    %% Initialization
    if isempty(initialized)
        %% Initial state estimate
        x0 = zeros(n_states, 1);

        x0(1) = IL_m(1);
        x0(2) = IL_m(2);
        x0(3) = IL_m(3);
        x0(4) = Vout_m;
        x0(5) = Vin_m;

        x_pred = x0;

        %% Parameters
        L_nom   = 80/1000;
        C_nom   = 12/1000;
        RL = 10e-3*ones(3, 1);
        VD  = 0.8*ones(3, 1);
        G_load = 0;
        Idc_load = 0;
        CP_load = 0;
        
        theta_pred = zeros(n_theta, 1);
        theta_pred(1:3) = 1/L_nom;
        theta_pred(4:6) = RL/L_nom;
        theta_pred(7:9) = VD/L_nom;
        theta_pred(10) = 1/C_nom;
        theta_pred(11) = G_load/C_nom;
        theta_pred(12) = Idc_load/C_nom;
        theta_pred(13) = CP_load/C_nom;

        %% Initial covariance
        P_pred = eye(n_params);
        Gamma_pred = zeros(n_states, n_theta);

        %% Measurement noise covariance
        sigma_iL   = 0.1;
        sigma_Vout = 0.1;
        sigma_Vin  = 0.1;

        R_meas = diag([
            sigma_iL^2;
            sigma_iL^2;
            sigma_iL^2;
            sigma_Vout^2;
            sigma_Vin^2
        ]);

        sigma_theta = 0.1;
        R_theta = (sigma_theta^2)*eye(n_meas);

        sigma_model = 0.01;
        Q = diag([(sigma_model^2)*ones(n_states, 1); zeros(n_theta, 1)]);

        lambda_x = exp(-Ts/0.5);
        lambda_t = exp(-Ts/10);
        inv_lambda = diag([(1/lambda_x)*ones(n_states, 1); (1/lambda_t)*ones(n_theta, 1)]);

        %% 
        D_bot_last = zeros(3, 1);
        D_top_last = zeros(3, 1);

        %% Integral term
        int_eVout = 0.0;

        initialized = true;
    end

    %% Measurement vector at current sample
    y = [IL_m; Vout_m; Vin_m];

    %% update step
    [x_hat, theta_hat, P_pred, Gamma_hat] = update_state_theta( ...
        y, x_pred, theta_pred, P_pred, Gamma_pred, R_meas, R_theta, n_states, n_theta, inv_lambda, Q);

    IL = x_hat(1:3);
    Vout = x_hat(4);
    Vin = x_hat(5);

    tol_L = 0.2;
    L_min = (1 - tol_L)*L_nom;
    L_max = (1 + tol_L)*L_nom;
    theta_hat(1:3) = min(max(theta_hat(1:3), 1/L_max), 1/L_min);
    L = 1./theta_hat(1:3);
    theta_hat(4:6) = min(max(theta_hat(4:6).*L, 0.0001), 0.1)./L;
    theta_hat(7:9) = min(max(theta_hat(7:9).*L, 0.7), 2)./L;

    tol_C = 0.2;
    C_min = (1 - tol_C)*C_nom;
    C_max = (1 + tol_C)*C_nom;
    theta_hat(10) = min(max(theta_hat(10), 1/C_max), 1/C_min);
    C = 1/theta_hat(10);
    theta_hat(11) = min(max(theta_hat(11)*C, 0), 2)/C;
    theta_hat(12) = min(max(theta_hat(12)*C, 0), 160)/C;
    theta_hat(13) = min(max(theta_hat(13)*C, 0), 15000)/C;
    
    RL = theta_hat(4:6).*L;
    VD = theta_hat(7:9).*L;    
    G_load = theta_hat(11)*C;
    Idc_load = theta_hat(12)*C;
    CP_load = theta_hat(13)*C;

    %% Load Current
    I_load = G_load*Vout + Idc_load + CP_load/(Vout + 0.001);
    I_load_ref = G_load*Vout_ref + Idc_load + CP_load/Vout_ref;

    %% Derivatives
    % By model
    u_last = [D_bot_last; D_top_last];
    [Psi] = model_interleaved_converter(x_hat, u_last, Ts, converter_mode);
    x_dot = Psi*theta_hat/Ts;

    IL_dot = x_dot(1:3);
    Vout_dot = x_dot(4);

    %% Power equations
    Pin = Vin*sum(IL);
    Pout = Vout*I_load;
    PR = sum(RL.*IL.^2);
    PD = sum(VD.*IL.*(1 - D_bot_last));
    PL = sum(L.*IL.*IL_dot);
    PC = C*Vout*Vout_dot;
    
    %% Equilibrium current
    a = sum((Vout_ref.*RL)./(Vout_ref + VD));
    b = -Vin*sum(Vout_ref./(Vout_ref + VD));
    c = Vout_ref*I_load_ref;

    delta = b^2 - 4*a*c;
    if delta > 0
        IL_eq = -b/(2*a) - sqrt(delta)/(2*a); 
    else
        IL_eq = I_load/3;
    end

    %% Voltage error and integral
    e_Vout = Vout_ref - Vout;

    if abs(e_Vout) < 0.5*max(Vout_ref, 1.0)
        int_eVout = int_eVout + e_Vout * Ts;
    end

    %% Control laws

    if converter_mode == 0
        D_bot = 0.5*ones(3, 1);
        D_top = zeros(3, 1);
    else
        D_bot = zeros(3, 1);
        D_top = 0.5*ones(3, 1);
    end
    u = [D_bot; D_top];
    D_bot_last = D_bot;
    D_top_last = D_top;

    %% Prediction step
    [x_pred, theta_pred, Gamma_pred] = predict_state_theta( ...
        x_hat, u, theta_hat, Gamma_hat, Ts, converter_mode);

    %% Debug variables
    debug_obs = zeros(40, 1);
    debug_obs(1:5) = y - x_pred;
    debug_obs(6:10) = y - x_hat;
    debug_obs(11:13) = IL;
    debug_obs(14) = Vout;
    debug_obs(15) = Vin;
    debug_obs(16) = G_load;
    debug_obs(17) = Idc_load;
    debug_obs(18) = CP_load;
    debug_obs(19) = I_load;
    debug_obs(20:22) = L;
    debug_obs(23) = C;
    debug_obs(24:26) = RL;
    debug_obs(27:29) = VD;
    debug_obs(30) = Pin;
    debug_obs(31) = Pout;
    debug_obs(32) = PR;
    debug_obs(33) = PD;
    debug_obs(34) = PL;
    debug_obs(35) = PC;

    debug_deriv = zeros(25, 1);
    debug_deriv(1:3) = IL_dot;
    debug_deriv(4) = Vout_dot;

    debug_ctrl = zeros(25, 1);
    debug_ctrl(1:6) = u;
    debug_ctrl(7) = int_eVout;
    debug_ctrl(8) = I_load_ref;
    debug_ctrl(9) = IL_eq;
end

function [Psi] = model_interleaved_converter(x, u, Ts, converter_mode)
    IL = x(1:3);
    Vout = x(4);
    Vin = x(5);

    if converter_mode == 0
        d_bot = u(1:3);
        Psi = [diag(Vin - (1  - d_bot)*Vout) diag(-IL) diag(-(1 - d_bot)) zeros(3, 4);
               zeros(1, 9) sum(IL.*(1 - d_bot)) -Vout -1 -1/(Vout + 0.001);
               zeros(1, 13)];
    else
        d_top = u(4:6);
        Psi = [diag(Vin*d_top - Vout) diag(-IL) diag(-(1 - d_top)) zeros(3, 4);
               zeros(1, 9) sum(IL) -Vout -1 -1/(Vout + 0.001);
               zeros(1, 13)];
    end
    Psi = Psi*Ts;
end

%% Predict State and thetas
function [x_pred, theta_pred, Gamma_pred] = predict_state_theta( ...
    x, u, theta, Gamma, Ts, converter_mode)

    [Psi] = model_interleaved_converter(x, u, Ts, converter_mode);

    x_pred = x + Psi*theta;
    theta_pred = theta;
    Gamma_pred = Gamma - Psi;
end

%% Update
function [x_update, theta_update, P_update, Gamma_update] = update_state_theta( ...
    y, x_pred, theta_pred, P_pred, Gamma_pred, R_y, R_theta, n_states, n_theta, inv_lambda, Q)

    Px = P_pred(1:n_states, 1:n_states);
    Ptheta = P_pred(n_states+1:end, n_states+1:end);
    
    % Innovation
    innovation = y - x_pred;

    % Parameter correction gain
    Omega = Gamma_pred*Ptheta*Gamma_pred.' + R_theta;

    % State correction gain
    Kx = Px/(Px + R_y);

    % Safer than explicit inverse
    Ktheta = Ptheta*Gamma_pred.'/Omega;

    % Single gain variable
    K = [Kx zeros(n_states, n_theta); zeros(n_theta, n_states) Ktheta*Gamma_pred];

    P_update = inv_lambda*(eye(n_states + n_theta) - K)*P_pred + Q;
    P_update = 0.5*(P_update + P_update');

    % Corrected sensitivity
    Gamma_update = (eye(n_states) - Kx)*Gamma_pred;

    % State correction
    x_update = x_pred + (Kx + Gamma_update*Ktheta)*innovation;

    % Parameter correction
    %
    % The negative sign follows the observer convention used in the paper,
    % where Gamma represents sensitivity of the state-estimation error.
    theta_update = theta_pred - Ktheta*innovation;
end