plot(tc, IL, 'lineWidth', 2); hold on;
plot(td, IL_eq, '--', 'lineWidth', 2); hold on;
grid on; grid minor;
xlabel("Tempo (s)");
ylabel("Corrente (A)");
legend("IL1", "IL2", "IL3", "Referencia", 'Location','best')
title('Correntes nos indutores', 'FontSize', 18);

subplot(2, 1, 2)
